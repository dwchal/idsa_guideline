		<script>
		(function () {
			var attemptsRemaining = 40;

			function displayAndRefreshAds() {
				googletag.cmd.push(function () {
					var pubads = googletag.pubads();
					var pageSlots = pubads.getSlots().filter(function (slot) {
						var elementId = slot.getSlotElementId();
						return elementId && document.getElementById(elementId);
					});

					if (pageSlots.length === 0 && attemptsRemaining-- > 0) {
						window.setTimeout(displayAndRefreshAds, 250);
						return;
					}

					if (pageSlots.length === 0) {
						return;
					}

					// An earlier display call may have run before GTM defined the slot.
					pageSlots.forEach(function (slot) {
						googletag.display(slot);
					});

					pubads.refresh(pageSlots);
				});
			}

			displayAndRefreshAds();
		}());
		</script>
